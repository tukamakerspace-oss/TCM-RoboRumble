const int RIGHT_STEP = 21;
const int RIGHT_DIR = 22;

void setup() {
  pinMode(RIGHT_STEP, OUTPUT);
  pinMode(RIGHT_DIR, OUTPUT);

  digitalWrite(RIGHT _DIR, HIGH);

  for (int i = 0; i < 200; i++) {
    digitalWrite(RIGHT _STEP, HIGH);
    delay(2);

    digitalWrite(RIGHT_STEP, LOW);
    delay(2);
  }
}

void loop() {
}
