  pinMode(LEFT_STEP, OUTPUT);
  pinMode(LEFT_DIR, OUTPUT);

  digitalWrite(LEFT _DIR, HIGH);

  for (int i = 0; i < 200; i++) {
    digitalWrite(LEFT _STEP, HIGH);
    delay(2);

    digitalWrite(LEFT_STEP, LOW);
    delay(2);
  }
}

